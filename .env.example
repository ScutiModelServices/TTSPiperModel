# Copy to .env (git-ignored). Docker compose reads it from this folder; run.bat loads it for a local run (it passes --dotenv and prints the variable names it loaded); a real environment variable wins.
# Start-up values only: a value saved on the admin Settings card (/admin/) beats .env.

# Admin password: unlocks /admin/, where you create a token per caller; callers send theirs as X-Internal-Token.
# Empty = no auth at all (local use only).
TTSPIPER_ADMIN_PASSWORD=

# Port the service listens on (compose: the port published by the load balancer).
TTSPIPER_PORT=9150

# Compose only: API copies behind nginx. Each copy loads the model in RAM (about 300 MB per replica with one voice loaded).
TTSPIPER_REPLICAS=1

# CPU threads for generation (onnxruntime decides when unset). A value saved on the /admin/ page beats this one.
# TTSPIPER_NUM_THREAD=4

# Tunables (update check hours, in-flight cap, answers kept, voices served, voices repository, load at start) are set on the /admin/
# Settings card and saved in settings.json. These variables are only a starting value for run.bat; compose does not
# pass them. A saved value wins.
# TTSPIPER_UPDATE_CHECK_HOURS=6
# TTSPIPER_MAX_INFLIGHT=
# TTSPIPER_VOICES=en_US-lessac-medium
# TTSPIPER_MODEL=rhasspy/piper-voices
# TTSPIPER_WARM=1

# run.bat only (compose sets these itself): bind address.
# TTSPIPER_HOST=127.0.0.1
# Where tokens are stored (hashed) and the admin page folder. Docker sets /data/tokens.json and /app/web.
# TTSPIPER_TOKENS_FILE=tokens.json
# TTSPIPER_WEB_DIR=web
